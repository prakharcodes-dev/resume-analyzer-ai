# AI Resume Analyzer Environment Variables Example

# Server Port (Default: 8080 for local development, dynamic for production cloud platforms like Render)
PORT=8080

# Database Configuration (Optional Overrides)
SPRING_DATASOURCE_URL=jdbc:h2:file:./resume_analyzer;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
